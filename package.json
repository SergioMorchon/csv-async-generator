{
  "name": "csv-async-generator",
  "version": "1.0.8",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prettier": "prettier \"**/*.{ts,json,md,yml}\"",
    "prettier:check": "yarn prettier -l",
    "prettier:write": "yarn prettier -l -w",
    "build": "vite build && yarn build:types",
    "build:types": "tsc --noEmit false --emitDeclarationOnly --declaration --declarationMap --declarationDir dist",
    "test": "vitest run"
  },
  "author": "Sergio Morchón Poveda <sergio.morchon@outlook.com>",
  "license": "MIT",
  "packageManager": "yarn@4.18.1",
  "devDependencies": {
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
